<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DivoomPcMonitor.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="28,20,28,28">
        <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="About" />
            <TextBlock
                x:Name="DescriptionText"
                Opacity="0.8"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap" />
            <Border Style="{StaticResource StatCard}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Application" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock x:Name="NameText" Style="{StaticResource BodyTextBlockStyle}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Version" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource BodyTextBlockStyle}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="File version" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock x:Name="FileVersionText" Style="{StaticResource BodyTextBlockStyle}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Author" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock x:Name="AuthorText" Style="{StaticResource BodyTextBlockStyle}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Copyright" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock x:Name="CopyrightText" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="License" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="MIT" Style="{StaticResource BodyTextBlockStyle}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Architecture" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock x:Name="ArchitectureText" Style="{StaticResource BodyTextBlockStyle}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Program" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock x:Name="ProgramText" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
