<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DivoomPcMonitor</RootNamespace>
    <AssemblyName>DivoomPcMonitor</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifiers>win-arm64;win-x64</RuntimeIdentifiers>
    <!-- A self-contained unpackaged build needs a RID. Use this PC when -r was not passed. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and $([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString()) == 'X64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and $([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString()) == 'Arm64'">win-arm64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SatelliteResourceLanguages>en-US;en</SatelliteResourceLanguages>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Description>Send PC usage to a Divoom Times Gate or Pixoo64.</Description>
    <!-- About reads these. The WinUI assembly version is not the Windows App SDK package version. -->
    <WindowsAppSdkPackageVersion>2.6.5</WindowsAppSdkPackageVersion>
    <WindowsSdkBuildToolsVersion>10.0.28000.2957</WindowsSdkBuildToolsVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$(WindowsAppSdkPackageVersion)" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="$(WindowsSdkBuildToolsVersion)" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
  </ItemGroup>
  <!-- NETCoreSdkVersion is set by the SDK targets, after the project file is read. -->
  <Target Name="AddDeveloperVersionMetadata" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <AssemblyMetadata Include="NetSdkVersion" Value="$(NETCoreSdkVersion)" />
      <AssemblyMetadata Include="WindowsAppSdkVersion" Value="$(WindowsAppSdkPackageVersion)" />
      <AssemblyMetadata Include="WindowsSdkBuildToolsVersion" Value="$(WindowsSdkBuildToolsVersion)" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\DivoomPcMonitor.Core\DivoomPcMonitor.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
