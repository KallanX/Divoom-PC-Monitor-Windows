<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DivoomPcMonitor.MonitorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">
    <Grid Padding="28,20,28,28">
        <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Monitor" VerticalAlignment="Center" />
                <Button x:Name="RunButton" VerticalAlignment="Center" Click="RunButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon x:Name="RunIcon" Symbol="Play" />
                        <TextBlock x:Name="RunLabel" Text="Start" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock
                x:Name="Subtitle"
                Style="{StaticResource BodyTextBlockStyle}"
                Opacity="0.8"
                TextWrapping="Wrap"
                Text="Six readings go to the Divoom, in this order: CPU, GPU, CPU temperature, GPU temperature, memory, and disk." />
            <InfoBar x:Name="StatusBar" IsOpen="True" IsClosable="False" Severity="Informational" Title="Status" />

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource StatCard}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border
                                Width="34"
                                Height="34"
                                CornerRadius="8"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <FontIcon
                                    Glyph="&#xE950;"
                                    FontSize="16"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="CPU" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xEC4A;" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                                <TextBlock Text="Utilization" Opacity="0.75" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="CpuValue" Text="--" Style="{StaticResource StatValue}" />
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE9CA;" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                                <TextBlock Text="Temperature" Opacity="0.75" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="CpuTempValue" Text="--" Style="{StaticResource StatValue}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource StatCard}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border
                                Width="34"
                                Height="34"
                                CornerRadius="8"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <FontIcon
                                    Glyph="&#xE7F4;"
                                    FontSize="16"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="GPU" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xEC4A;" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                                <TextBlock Text="Utilization" Opacity="0.75" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="GpuValue" Text="--" Style="{StaticResource StatValue}" />
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE9CA;" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                                <TextBlock Text="Temperature" Opacity="0.75" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="GpuTempValue" Text="--" Style="{StaticResource StatValue}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource StatCard}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border
                                Width="34"
                                Height="34"
                                CornerRadius="8"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <FontIcon
                                    Glyph="&#xE964;"
                                    FontSize="16"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="RAM" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xEC4A;" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                                <TextBlock Text="Usage" Opacity="0.75" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="MemoryValue" Text="--" Style="{StaticResource StatValue}" />
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE9D9;" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                                <TextBlock Text="Memory pool" Opacity="0.75" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="System" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="20" Opacity="0.85" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource StatCard}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border
                                Width="34"
                                Height="34"
                                CornerRadius="8"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <FontIcon
                                    Glyph="&#xEDA2;"
                                    FontSize="16"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Disk" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xEC4A;" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                                <TextBlock Text="Usage" Opacity="0.75" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="DiskValue" Text="--" Style="{StaticResource StatValue}" />
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xEDA2;" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                                <TextBlock Text="Active drive" Opacity="0.75" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="DiskName" Text="--" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="20" Opacity="0.85" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource StatCard}">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border
                            Width="34"
                            Height="34"
                            CornerRadius="8"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <FontIcon
                                Glyph="&#xE823;"
                                FontSize="16"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Schedule" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" VerticalAlignment="Center" />
                    </StackPanel>
                    <NumberBox
                        x:Name="IntervalBox"
                        Header="Seconds to wait after each update"
                        Minimum="1"
                        Maximum="86400"
                        SmallChange="1"
                        LargeChange="10"
                        SpinButtonPlacementMode="Inline"
                        ValueChanged="IntervalBox_ValueChanged" />
                    <TextBlock
                        Opacity="0.7"
                        TextWrapping="Wrap"
                        Text="Each update spends about one second measuring CPU, GPU, and disk. The wait above starts after that update finishes." />
                    <ToggleSwitch x:Name="LoginSwitch" Header="Start at sign-in" OnContent="On" OffContent="Off" Toggled="LoginSwitch_Toggled" />
                    <ToggleSwitch x:Name="DebugSwitch" Header="Write a debug log" OnContent="On" OffContent="Off" Toggled="DebugSwitch_Toggled" />
                    <TextBlock
                        Opacity="0.7"
                        TextWrapping="Wrap"
                        Text="Closing this window leaves the monitor running in the tray. Quit from the tray icon to stop it. Start at sign-in does not need administrator." />
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
