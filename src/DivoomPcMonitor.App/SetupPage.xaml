<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DivoomPcMonitor.SetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">
    <Grid Padding="28,20,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Setup" />
        <StackPanel Grid.Row="1" Margin="0,8,0,12" Orientation="Horizontal" Spacing="10">
            <Border
                Width="28"
                Height="28"
                CornerRadius="6"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                <FontIcon
                    x:Name="StepIcon"
                    Glyph="&#xE713;"
                    FontSize="14"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Border>
            <TextBlock
                x:Name="StepTitle"
                Style="{StaticResource SubtitleTextBlockStyle}"
                VerticalAlignment="Center"
                Text="Current configuration" />
        </StackPanel>
        <InfoBar x:Name="Notice" Grid.Row="2" Margin="0,0,0,12" IsOpen="False" IsClosable="False" />

        <ScrollViewer x:Name="SummaryView" Grid.Row="3" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14">
                <TextBlock
                    Opacity="0.8"
                    Style="{StaticResource BodyTextBlockStyle}"
                    TextWrapping="Wrap"
                    Text="This computer already has a configuration. Recreate walks through the device, screen, drive, and GPU again. Apply replaces this file and selects the PC Monitor app." />

                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource StatCard}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border
                                    Width="34"
                                    Height="34"
                                    CornerRadius="8"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <FontIcon
                                        Glyph="&#xE7F4;"
                                        FontSize="16"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Divoom Device" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" VerticalAlignment="Center" />
                            </StackPanel>

                            <Grid ColumnSpacing="16" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE701;" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                                        <TextBlock Text="Device IP" Opacity="0.75" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="DeviceIpText" FontWeight="SemiBold" Style="{StaticResource BodyTextBlockStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE946;" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                                        <TextBlock Text="Device ID" Opacity="0.75" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="DeviceIdText" FontWeight="SemiBold" Style="{StaticResource BodyTextBlockStyle}" />
                                </StackPanel>

                                <Border Grid.Row="1" Grid.ColumnSpan="2" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <StackPanel Grid.Row="2" Grid.Column="0" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE7F8;" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                                        <TextBlock Text="LCD index / group" Opacity="0.75" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Screen" Opacity="0.75" Style="{StaticResource BodyTextBlockStyle}" />
                                        <TextBlock x:Name="LcdIndexText" FontWeight="SemiBold" Style="{StaticResource BodyTextBlockStyle}" />
                                        <TextBlock Text="· Group" Opacity="0.75" Style="{StaticResource BodyTextBlockStyle}" />
                                        <TextBlock x:Name="LcdIndependenceText" FontWeight="SemiBold" Style="{StaticResource BodyTextBlockStyle}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE823;" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                                        <TextBlock Text="Stored clock ID" Opacity="0.75" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="LcdClockText" FontWeight="SemiBold" Style="{StaticResource BodyTextBlockStyle}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource StatCard}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border
                                    Width="34"
                                    Height="34"
                                    CornerRadius="8"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <FontIcon
                                        Glyph="&#xE950;"
                                        FontSize="16"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Monitored Hardware" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" VerticalAlignment="Center" />
                            </StackPanel>

                            <Grid ColumnSpacing="16" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE950;" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                                        <TextBlock Text="CPU vendor" Opacity="0.75" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="CpuText" FontWeight="SemiBold" Style="{StaticResource BodyTextBlockStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xEDA2;" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                                        <TextBlock Text="Drives" Opacity="0.75" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="DrivesText" FontWeight="SemiBold" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                                </StackPanel>

                                <Border Grid.Row="1" Grid.ColumnSpan="2" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <StackPanel Grid.Row="2" Grid.Column="0" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE7F4;" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                                        <TextBlock Text="GPU vendor" Opacity="0.75" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="GpuVendorText" FontWeight="SemiBold" Style="{StaticResource BodyTextBlockStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE964;" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                                        <TextBlock Text="GPU bus / LUID" Opacity="0.75" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock x:Name="GpuPciText" Style="{StaticResource CaptionTextBlockStyle}" />
                                        <TextBlock Text="·" Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}" />
                                        <TextBlock x:Name="GpuLuidText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Spacing="2">
                                    <TextBlock Text="GPU model" Opacity="0.75" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock x:Name="GpuNameText" FontWeight="SemiBold" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource StatCard}">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8A5;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Configuration file" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="FileText" FontFamily="Consolas" Opacity="0.85" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="WizardView" Grid.Row="3" Visibility="Collapsed" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <Border Style="{StaticResource StatCard}" MaxWidth="760" HorizontalAlignment="Stretch">
                <StackPanel x:Name="Body" Spacing="10" />
            </Border>
        </ScrollViewer>

        <StackPanel Grid.Row="4" Margin="0,16,0,0" Orientation="Horizontal" Spacing="8">
            <Button x:Name="RecreateButton" Style="{StaticResource AccentButtonStyle}" Click="Recreate_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Recreate configuration" />
                </StackPanel>
            </Button>
            <Button x:Name="CancelButton" Content="Cancel" Visibility="Collapsed" Click="Cancel_Click" />
            <Button x:Name="BackButton" Visibility="Collapsed" Click="Back_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="12" />
                    <TextBlock Text="Back" />
                </StackPanel>
            </Button>
            <Button x:Name="NextButton" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" Click="Next_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock x:Name="NextButtonText" Text="Next" />
                    <FontIcon x:Name="NextButtonIcon" Glyph="&#xE72A;" FontSize="12" />
                </StackPanel>
            </Button>
            <ProgressRing x:Name="Busy" Width="24" Height="24" IsActive="False" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
